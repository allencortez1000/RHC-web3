        "test:offline": "tsc -p tsconfig.offline.json && node --test test/readonly.test.cjs",
    "test:network": "npm run build && node scripts/testnet-read.cjs"
  },
  "dependencies": { "@rhc/types": "0.1.0", "thirdweb": "5.121.6" }
}
