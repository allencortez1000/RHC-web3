# Backend only. This file is a template, not activation approval.
RHC_WEB3_PROVIDER=disabled
# Maps to FeatureService; not a database-managed write/financial capability.
ENABLE_WEB3_READ_PREVIEW=false
RHC_WEB3_ALLOW_NETWORK_READS=false
RHC_WEB3_NETWORK_MODE=testnet
# No approved chain/contract exists yet. Never substitute mainnet.
RHC_WEB3_CHAIN_ID=
RHC_WEB3_TOKEN_CONTRACT_ADDRESS=
THIRDWEB_SECRET_KEY=
RHC_WEB3_READ_TIMEOUT_MS=5000
RHC_WEB3_CACHE_TTL_SECONDS=30
RHC_WEB3_MAX_STALE_SECONDS=120
# Separate operator confirmation used only by the opt-in CLI read test.
RHC_WEB3_ACCEPTANCE_AUTHORIZED=false
