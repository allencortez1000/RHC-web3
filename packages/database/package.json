{
  "name": "@rhc/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "tsx": "^4.16.2"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:acl:preflight": "tsx prisma/application-acl-preflight.ts",
    "test:connected-domain": "tsx --test prisma/connected-domain.spec.ts prisma/connected-domain-catalog.spec.ts prisma/connected-domain-upgrade.spec.ts",
    "typecheck:connected-domain": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --types node prisma/connected-domain-source.ts prisma/connected-domain-gates.ts prisma/connected-domain-verify.ts prisma/connected-domain-disposable.ts prisma/connected-domain.spec.ts prisma/connected-domain-catalog.spec.ts prisma/connected-domain-structure.ts prisma/connected-domain-upgrade.ts prisma/connected-domain-upgrade.spec.ts",
    "db:connected-domain:manifest": "tsx prisma/connected-domain-source.ts",
    "db:connected-domain:verify": "tsx prisma/connected-domain-verify.ts",
    "db:connected-domain:disposable": "tsx prisma/connected-domain-disposable.ts",
    "db:connected-domain:upgrade": "tsx prisma/connected-domain-upgrade.ts",
    "test": "tsx --test prisma/seed.spec.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma --ext .ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
