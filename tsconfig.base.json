{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@rhc/types": ["packages/types/src"],
      "@rhc/types/*": ["packages/types/src/*"],
      "@rhc/validation": ["packages/validation/src"],
      "@rhc/config": ["packages/config/src"],
      "@rhc/shared": ["packages/shared/src"],
      "@rhc/ui": ["packages/ui/src"],
      "@rhc/database": ["packages/database/src"]
    }
  }
}
